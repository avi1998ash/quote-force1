<apex:page renderAs="pdf" sidebar="false" showHeader="false" docType="html-5.0" applyBodyTag="false" applyHtmlTag="false" standardStylesheets="false">
    <head>
        <style>
            @page {
            size: A4;
            margin: 0;
            background: #b7c4cf;
            }
            
            body {
            font-family: 'Segoe UI', 'Helvetica', sans-serif;
            font-size: 13px;
            color: #2b2b2b;
            background-color: #fff;
            }
            
            .header-second {
            background-color: #0f395f;
            color: #fff;
            padding: 15px;
            font-size: 20px;
            font-weight: 600;
            text-align: center;
            border-radius: 6px;
            margin-bottom: 25px;
            margin-top: 8px;
            }
            
            .header {
            background-color: #0f395f;
            color: #fff;
            padding: 15px;
            font-size: 20px;
            font-weight: 600;
            text-align: center;
            border-radius: 6px;
            margin-bottom: 25px;
            }
            
            .section {
            background-color: #f2f4f7;
            border: 1px solid #dbe1e8;
            padding: 18px 20px;
            border-radius: 10px;
            margin-bottom: 25px;
            page-break-inside: avoid;
            }
            
            .section-title {
            font-size: 16px;
            color: #0f395f;
            font-weight: 600;
            margin-bottom: 12px;
            border-bottom: 1px solid #ccd4de;
            padding-bottom: 4px;
            }
            
            .field {
            margin-bottom: 10px;
            display: flex;
            gap: 10px;
            }
            
            .label {
            font-weight: 600;
            width: 160px;
            color: #0f395f;
            }
            
            .value {
            flex: 1;
            color: #333;
            }
            
            .image-box {
            width: 200px;
            height: 120px;
            border: 1px dashed #999;
            border-radius: 6px;
            text-align: center;
            line-height: 120px;
            color: #999;
            background-color: #fff;
            margin-top: 6px;
            }
            
            .page-break {
            page-break-before: always;
            }
            
            body {
            font-family: 'Helvetica', sans-serif;
            color: #333;
            }
            
            .section-name {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 15px;
            color: #0f395f;
            }
            
            .table-container {
            width: 100%;
            border-collapse: collapse;
            }
            
            .table-header {
            background-color: #0f395f;
            color: #ffffff;
            font-weight: bold;
            }
            
            .table-container td,
            .table-container th {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: center;
            }
            
            .table-row {
            background-color: #f9f9f9;
            }
            
            .section-total {
            text-align: right;
            font-size: 14px;
            margin-top: 10px;
            font-weight: bold;
            }
            
            .note {
            margin-top: 20px;
            font-size: 12px;
            color: #555;
            }
            
            .warranty-termNcondition{
            display: flex; 
            justify-content: center;
            align-items: center;
            height: 100vh;
            }
            
        </style>
    </head>
